<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.monograph</groupId>
    <artifactId>monograph-gateway</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>monograph-gateway</name>
    <description>Monograph GraphQL gateway - aggregates Customer, Account and Financial services</description>

    <properties>
        <java.version>21</java.version>
        <!-- Two @SpringBootApplication classes live in this module; the gateway is the packaged one. -->
        <start-class>com.monograph.gateway.MonographGatewayApplication</start-class>
    </properties>

    <dependencies>
        <!-- Spring for GraphQL: schema loading, annotated controllers, /graphql endpoint -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-graphql</artifactId>
        </dependency>
        <!-- HTTP transport (Spring MVC + embedded Tomcat) for POST /graphql -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- RestClient.Builder for calling the downstream Customer / Account / Financial services -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>

        <!-- Test: @GraphQlTest slice, GraphQlTester / HttpGraphQlTester -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-graphql-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
